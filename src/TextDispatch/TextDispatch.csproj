<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TextDispatch</AssemblyName>
    <RootNamespace>TextDispatch</RootNamespace>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Keep this in step with the release tag so a downloaded DLL can be identified. -->
    <Version>1.0.12</Version>
    <AssemblyVersion>1.0.12.0</AssemblyVersion>
    <FileVersion>1.0.12.0</FileVersion>
    <Product>TextDispatch</Product>
    <Description>LSPDFR in text: callouts, dispatch and interactions through an in-game chat box.</Description>

    <!-- Where LSPDFR lives. Override with -p:GtaFolder="E:\Games\GTAV". -->
    <GtaFolder Condition="'$(GtaFolder)' == ''">D:\Grand Theft Auto V Legacy</GtaFolder>
    <LspdfrDll>$(GtaFolder)\plugins\LSPD First Response.dll</LspdfrDll>
    <LspdfrAvailable>false</LspdfrAvailable>
    <LspdfrAvailable Condition="Exists('$(LspdfrDll)')">true</LspdfrAvailable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <!-- RPH's native table (Rage.Native.NativeFunction.Natives) is dynamic. -->
    <Reference Include="Microsoft.CSharp" />
    <!-- JavaScriptSerializer, for reading the local model's reply. Part of the framework, so
         nothing extra has to be shipped alongside the plugin. -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!--
    The RAGE Plugin Hook SDK assembly.

    Private=false is legally as well as practically required: RPH's own terms say "do not include it
    with your plugins", so it must never be copied into our build output - at runtime the copy that
    is already loaded in the RPH process is used. The assembly's version is 0.0.0.0, so a plugin
    compiled against one RPH build loads fine on another.

    Put RagePluginHook.dll in tools\rph-sdk\ (it ships inside the official RAGE Plugin Hook download
    as SDK\RagePluginHook.dll, and is also published as the "RagePluginHook" SDK package).
  -->
  <ItemGroup>
    <Reference Include="RagePluginHook">
      <HintPath>$(MSBuildThisFileDirectory)..\..\tools\rph-sdk\RagePluginHook.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    LSPDFR itself, needed for one thing only: the plugin entry point has to derive from
    LSPD_First_Response.Mod.API.Plugin, because that is what LSPDFR instantiates. Deriving from a
    type needs it at compile time.

    Private=false is required rather than optional. LSPDFR must never be copied into this plugin's
    output: every callout pack works this way, referencing it and shipping without it, and the
    plugin loads against the copy already in the game. Building therefore needs LSPDFR installed.
  -->
  <ItemGroup Condition="'$(LspdfrAvailable)' == 'true'">
    <Reference Include="LSPD First Response">
      <HintPath>$(LspdfrDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="LspdfrMissing" BeforeTargets="BeforeBuild" Condition="'$(LspdfrAvailable)' != 'true'">
    <Error Text="LSPD First Response.dll not found at $(LspdfrDll). The plugin's entry point derives from LSPDFR's Plugin base class, so LSPDFR must be installed to build. Point at your game folder with: dotnet build -p:GtaFolder=&quot;D:\Grand Theft Auto V Legacy&quot;" />
  </Target>

  <Target Name="RphSdkMissing" BeforeTargets="BeforeBuild"
          Condition="!Exists('$(MSBuildThisFileDirectory)..\..\tools\rph-sdk\RagePluginHook.dll')">
    <Error Text="RAGE Plugin Hook SDK not found at tools\rph-sdk\RagePluginHook.dll. Get RAGE Plugin Hook from ragepluginhook.net and copy SDK\RagePluginHook.dll there, then rebuild." />
  </Target>

</Project>
