# What the people in a callout say when the player talks to them.
#
#   <id> = 'first line | second line | third line | ...'
#
# Read by tools\make-callout-library.ps1, which attaches the lines to the recipe with that id and writes
# them into the recipe's <Script>. TextDispatch asks for these before its own scripted replies and before
# the language model, so a suspect in a callout answers in character, in order, with no model involved -
# see src\TextDispatch\Bridges\CalloutScriptBridge.cs. The last line repeats, because somebody who has
# said their piece three times is still better company than somebody who has gone mute.
#
# A data file rather than code: Import-PowerShellDataFile parses it as data, so nothing in here can run.
# Written in plain single-quoted strings, which is why an apostrophe must be doubled - and why the
# generator refuses a line that has one, since a line that breaks the file is a library that will not
# build at all.
#
# The generator also refuses to write a library where any callout has fewer than three lines, or where a
# key here does not match a callout id: "every callout has a script" is checked, not hoped for.
#
# Who speaks: the first suspect in the scene, or the patient in a medical callout, or whoever is standing
# there if the callout has neither. One speaker per scene - a scene with two conversations in it is two
# callouts. So these lines are written in the voice of that person, and lines 1 to 3 read as a sequence:
# what they say first, what they say when pressed, and the turn.

@{

# ============================================================ The two that any agency can be sent to
'all-assault-on-officer' = 'I never touched him. Ask the man in the van, he pulled me off. | You are hurting my arm. It was already like that before you got here. | He went for me first. That is the whole of it. That is what happened.'
'all-officer-needs-assistance' = 'We had nothing to do with that. We were walking home. | Do not come closer. I am telling you, do not come closer. | You are not taking me in. I am not going back there.'

